{
  "name": "@rooz/calendar-core",
  "version": "0.1.0",
  "description": "Calendar-system-agnostic date engine and grid generator with first-class Jalali (Shamsi) support.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "keywords": [
    "calendar", "jalali", "shamsi", "persian", "farsi", "gregorian",
    "date", "scheduler", "grid", "rtl"
  ],
  "repository": { "type": "git", "url": "git+https://github.com/your-org/rooz-calendar.git", "directory": "packages/calendar-core" },
  "homepage": "https://github.com/your-org/rooz-calendar#readme",
  "bugs": { "url": "https://github.com/your-org/rooz-calendar/issues" },
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "jalali-moment": "^3.3.11"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^2.1.9"
  }
}
