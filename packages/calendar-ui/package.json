{
  "name": "@rooz/calendar-ui",
  "version": "0.1.0",
  "description": "shadcn-styled React calendar and scheduling views with native Jalali (Shamsi) and RTL support.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "react",
    "calendar",
    "scheduler",
    "jalali",
    "shamsi",
    "persian",
    "shadcn",
    "tailwind",
    "rtl",
    "month-view",
    "week-view"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-org/rooz-calendar.git",
    "directory": "packages/calendar-ui"
  },
  "homepage": "https://github.com/your-org/rooz-calendar#readme",
  "bugs": {
    "url": "https://github.com/your-org/rooz-calendar/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && pnpm build:css",
    "build:css": "tailwindcss -i ./src/styles/index.css -o ./dist/styles.css --minify && node -e \"require('node:fs').copyFileSync('src/styles/tokens.css','dist/tokens.css')\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@rooz/calendar-core": "^0.1.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-toggle-group": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@rooz/calendar-core": "workspace:*",
    "@tailwindcss/cli": "^4.0.6",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  }
}
